  "clauses": [
    { "clauseId": "C01", "sourceId": "S115-01", "locator": "115 學年度大學部", "text": "115學年度大學部入學學生，最低畢業學分總數為136學分，包括：共同教育課程 28 學分、系定專業必修學分 70 學分、必修總學分數 98 學分、系定主領域選修學分 38 學分。", "reading": "四個數字：136＝28＋70＋38，必修合計 98。" },
    { "clauseId": "C02", "sourceId": "S115-01", "locator": "115 學年度大學部", "text": "核心課程：必修課程共98學分（含共同教育課程28學分與系訂專業必修70學分）。管理級專業選修課程18學分。", "reading": "主領域選修 38 內另含管理級專業選修 18 的子條件。" },
    { "clauseId": "C03", "sourceId": "S115-02", "locator": "表：領域選修", "text": "系訂主領域選修學分至少36學分，建議依學群選課，外系相關課程選修至多8學分（含各航運講座）。", "reading": "主領域選修為 36／38 的版本差異；外系相關課程有 8 學分上限。", "status": "pending", "note": "36 與 38 為不同年度版本，需系所確認 115 適用值。" },
    { "clauseId": "C04", "sourceId": "S115-02", "locator": "航行／船務領域", "text": "航行領域建議必選課程19學分（進階航海人員課程19/34）。船務領域建議必選課程14學分（基礎課程14/34）。", "reading": "領域建議必選為建議性質，未列為硬性門檻。", "status": "pending" },
    { "clauseId": "C05", "sourceId": "S115-02", "locator": "海上實習", "text": "暑假期間分三階段開設海上實習課程，為選修課程。", "reading": "實習是否為畢業必要條件需系所確認，本樣本先不列為必要條件。" }
  ],
