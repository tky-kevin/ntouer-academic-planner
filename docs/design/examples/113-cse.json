  ],
  "clauses": [
    { "clauseId": "C01", "sourceId": "S113-02", "locator": "第二條", "text": "學生除必須修習校訂共同必修科目28學分，本系自訂必修科目50學分外，另須至少選修57學分；總計須至少修習135學分方能畢業。", "reading": "三個學分池與總學分下限。" },
    { "clauseId": "C02", "sourceId": "S113-02", "locator": "第三條二（一）", "text": "系內選修科目至少需修滿46學分，其中核心選修科目至少修滿12學分。", "reading": "核心 12 為系內 46 的子集合，不是額外 12。" },
    { "clauseId": "C03", "sourceId": "S113-02", "locator": "第三條二（一）5", "text": "電資學院非上述學程之課程以6學分為上限。", "reading": "採計上限 6。" },
    { "clauseId": "C04", "sourceId": "S113-02", "locator": "第三條二（二）5", "text": "共同教育課程至多抵免 8 學分。", "reading": "額外共同教育可抵外系選修，最多 8。" },
    { "clauseId": "C05", "sourceId": "S113-03", "locator": "（Ⅰ）博雅(通識)領域", "text": "本領域課程包括人文探索、社會脈動、科技創新與跨域永續等四大子領域，跨域永續至少需修二學分，各領域至多認列四學分。", "reading": "四領域各有 4 學分上限，跨域永續另設 2 學分下限。" },
    { "clauseId": "C06", "sourceId": "S113-03", "locator": "（Ⅰ）體育領域", "text": "體育領域：四門都要是0學分的體育課。課號不得相同。", "reading": "四門 0 學分、課號不得重複，屬非學分條件。" },
    { "clauseId": "C07", "sourceId": "S113-03", "locator": "（Ⅱ）系訂專業必修", "text": "計算機概論、程式設計、微積分（上）（下）、離散數學、程式設計(二)、資料結構、演算法、數位邏輯、數位邏輯實驗、電腦網路、計算機組織學、線性代數、機率論、作業系統、資工系專題(一)(二)、資訊專題討論。", "reading": "18 個指定必修節點，合計 50 學分。" },
    { "clauseId": "C08", "sourceId": "S113-08", "locator": "第 39 條", "text": "學生修業期滿，合於下列各款規定，並完成校內審核作業者，准予畢業：一、修滿本校規定年限及規定科目與學分。二、體育成績四學期均及格。三、操行成績各學期均及格。", "reading": "除學分外，操行與體育成績也是畢業條件。" },
    { "clauseId": "C09", "sourceId": "S113-09", "locator": "體育課程備註", "text": "須修滿四學期之零學分必修課程，其中至少必須修習游泳課程一學期……免修者應另修習一門體育課程。", "reading": "游泳為體育內的必要一學期；免修需補一門。" },
    { "clauseId": "C10", "sourceId": "S113-09", "locator": "英語文領域備註", "text": "大二進階英文：須修滿二學分。修習門檻：限大二（含）以上學生，或已抵免大一英文四學分之大一學生始可修習。", "reading": "進階英文 2 學分另有修習資格限制。" }
  ],
