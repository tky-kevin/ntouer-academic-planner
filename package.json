{
  "name": "ntouer-academic-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:ais": "tsc -p tsconfig.server.json",
    "demo:ais": "tsx scripts/demo-ais-fixtures.ts",
    "verify:ais:live": "node --env-file-if-exists=.env.local --import tsx scripts/verify-live-ais.ts",
    "build": "tsc -b && node scripts/clean-dist.mjs && vite build && node scripts/verify-client-boundary.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:seed": "node scripts/db/seed.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "~5.2.0",
    "jsdom": "^29.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "~7.3.7",
    "vitest": "^5.0.4"
  }
}
