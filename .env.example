# 複製成 .env.local 再填值；`.env*` 與 client_secret*.json 都已被 gitignore，不得提交。
# 這份檔案是可提交的範本：所有值留空或放安全預設，不放任何真實憑證。
# 載入方式：`npm run start:api` 會讀 .env.local（server/env.ts）；
#          `npm run verify:ais:live` 用 node --env-file-if-exists=.env.local。

# ── 教務（AIS）同步：FR-02／AP-I2-03 ─────────────────────
# 學號（AIS 登入帳號）。留空時只能用「UI 臨時輸入」的方式同步。
AIS_ACCOUNT=
# AIS 密碼。只放本機 .env.local；不寫入資料庫、日誌、瀏覽器儲存。
AIS_PASSWORD=
# 數字成績的及格門檻（0–100）。留空 → 數字成績一律回 unknown（不假設及格分數）。
# 目前建議值 60，來源：國立臺灣海洋大學學則（data/rules/sources-manifest.json 的 S113-08）。
AIS_GRADE_PASSING_SCORE=
# 選填：同步時要抓的課表學年／學期。留空 → 用 AIS 查詢頁目前選取的值（不猜）。
AIS_TIMETABLE_YEAR=
AIS_TIMETABLE_TERM=
# 驗證碼待輸入狀態的存活秒數（伺服器記憶體，過期即丟棄）。
AIS_SYNC_CAPTCHA_TTL_SECONDS=300
# 單次同步的整體上限（毫秒）；逾時回 502 SYNC_FAILED，保留前次快照。
AIS_SYNC_TIMEOUT_MS=60000
# 選填：驗證碼 OCR 服務（POST 原始 PNG）。留空 → 由使用者在同步對話框輸入四碼。
AIS_OCR_URL=
AIS_OCR_TOKEN=
# 選填（除錯用）：AIS 頁面改版、出現 contractChanged 時，把每個回應 body 存到這個目錄。
# 內容含個人成績，目錄必須在 gitignore（tmp/ 已忽略）。平常請留空。
AIS_DEBUG_DUMP=

# ── 伺服器 ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Google OIDC（ADR-0003）───────────────────────────────
# 由 Google Cloud Console 的 OAuth 2.0 Client（Web application）取得。
# redirect URI 必須與 Console 設定完全一致。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# 工作階段 cookie 的簽章金鑰；本機可隨意產生，正式環境請用強隨機值。
SESSION_SECRET=

# ── 開發用身分（沒有 session 時的本機替身）──────────────
# `GET /api/me/progress` 在沒有 planner_session cookie 時，若 NODE_ENV != production
# 就用這筆 users.google_sub 當登入者；`npm run db:seed` 會建立 dev-student。
# production 一律忽略此值（必須真的登入）。
DEV_USER_SUB=dev-student

# ── 資料庫（ADR-0002／0004）─────────────────────────────
# 本機容器：docker compose up -d db（見 compose.yaml），對外 5433。
DATABASE_URL=postgres://planner:planner@localhost:5433/planner
