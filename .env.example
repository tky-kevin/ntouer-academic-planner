# Copy to .env.local; never commit credentials.
# .env.local 與 client_secret*.json 都已被 gitignore。

# ── 教務（AIS）────────────────────────────────────────────
AIS_ACCOUNT=
AIS_PASSWORD=
# Leave blank until an applicable numeric passing policy is confirmed.
AIS_PASSING_SCORE=
AIS_TIMETABLE_YEAR=
AIS_TIMETABLE_TERM=
AIS_CATALOG_YEAR=

# ── 伺服器 ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Google OIDC（ADR-0003）───────────────────────────────
# 由 Google Cloud Console 的 OAuth 2.0 Client（Web application）取得。
# redirect URI 必須與 Console 設定完全一致。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# 工作階段 cookie 的簽章金鑰；本機可隨意產生，正式環境請用強隨機值。
SESSION_SECRET=

# ── 資料庫（ADR-0002／0004）─────────────────────────────
# 本機容器：docker run -d --name planner-db -p 5433:5432 \
#   -e POSTGRES_USER=planner -e POSTGRES_PASSWORD=planner -e POSTGRES_DB=planner postgres:16-alpine
DATABASE_URL=postgres://planner:planner@localhost:5433/planner